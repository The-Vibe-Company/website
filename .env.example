DATABASE_URL=postgresql://user:password@localhost:5432/thevibecompany
CONTENT_WRITE_TOKEN=choose-a-long-random-token-for-the-write-api

# Vercel Blob Storage (REQUIRED in production — media uploads fail without this)
BLOB_READ_WRITE_TOKEN=

# Environment
NODE_ENV=development

# Vercel Deploy Hook (triggers rebuild when CMS content changes)
VERCEL_DEPLOY_HOOK_URL=

# PostHog (frontend analytics). Only initializes on the Vercel production
# deployment: next.config.ts inlines VERCEL_ENV as NEXT_PUBLIC_VERCEL_ENV, and
# anything other than "production" (local dev, previews, CI) leaves it off.
# To check events locally, start the dev server with VERCEL_ENV=production.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
